```razor
@page "/crearPrestamo"
@rendermode InteractiveServer

<PageTitle>Registrar Préstamo</PageTitle>

<EditForm Model="prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Registrar Préstamo</h5>
            </div>

            <div class="card-body">

                @* Prestamo *@
                <div class="mb-3">
                    <label class="form-label">
                        <strong>Id</strong>
                    </label>
                    <InputNumber class="form-control"
                                 @bind-Value="prestamo.PrestamosId"
                                 readonly>
                    </InputNumber>
                </div>

                @* EstudianteId *@
                <div class="mb-3">
                    <label class="form-label">
                        <strong>Estudiante</strong>
                    </label>
                    <InputSelect class="form-control form-select"
                                 @bind-Value="prestamo.EstudianteId">
                        <option value="0">Elija una opción</option>
                        @foreach (var estudiante in estudiantes)
                        {
                            <option value="@estudiante.EstudianteId">
                                @estudiante.Nombres
                            </option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => prestamo.EstudianteId)" />
                </div>

                @* Libro *@
                <div class="mb-3">
                    <label class="form-label">
                        <strong>Libro</strong>
                    </label>
                    <InputSelect class="form-control form-select"
                                 @bind-Value="prestamo.LibrosId">
                        <option value="0">Elija una opción</option>
                        @foreach (var libro in libros)
                        {
                            <option value="@libro.LibroID">
                                @libro.Titulo
                            </option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => prestamo.LibrosId)" />
                </div>

            </div>

            @* Footer *@
            <div class="card-footer text-center mt-2">
                <a href="/prestamoIndex" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span>
                    Volver
                </a>

                <button type="submit" class="btn btn-primary">
                    <span class="bi bi-floppy"></span>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public PrestamoLibros prestamo = new PrestamoLibros();
    public string Mensaje { get; set; } = string.Empty;

    public List<Estudiantes> estudiantes { get; set; } = new();
    public List<Libros> libros { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var estudiantesResult = await estudianteS.GetList(e => true);
        estudiantesResult.OnSuccess(e => estudiantes = e);

        var librosResult = await libroService.GetList(
            l => l.LibroID > 0 && l.Disponible
        );
        librosResult.OnSuccess(l => libros = l);
    }

    private async Task Guardar()
    {
        var creado = await prestamoS.Guardar(prestamo);

        creado.OnSuccess(() =>
        {
            toastServices.ShowSuccess("Préstamo registrado correctamente");
            navigationManager.NavigateTo("/prestamoIndex");
        });

        creado.OnFailure(() =>
        {
            toastServices.ShowError("Error al registrar el préstamo");
        });
    }
}


