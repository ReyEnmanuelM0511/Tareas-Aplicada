
@page "/prestamoIndex"
@rendermode InteractiveServer

<PageTitle>Historial de Prestamos</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title mt-2">Historial de Prestamos</h5>

            <a href="/crearPrestamo" class="btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span> Agregar Préstamo
            </a>
        </div>

        <div class="card-body">
            @* Labels *@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label">
                        <strong>Filtrar por</strong>
                    </label>
                </div>

                <div class="col-4">
                    <label class="col-form-label">
                        <strong>Búsqueda</strong>
                    </label>
                </div>
            </div>

            @* Inputs y botones *@
            <div class="row align-items-center">
                @* Filtro *@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opción</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Titulo">Título</option>
                    </InputSelect>
                </div>

                @* Búsqueda *@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control"
                               @bind="ValorFiltro"
                               placeholder="Buscar" />

                        <button type="button"
                                class="btn btn-outline-primary bi bi-search"
                                @onclick="Buscar">
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property="@(p => p.PrestamosId)"
                                    Title="Id Préstamo"
                                    Sortable="true" />

                    <PropertyColumn Property="@(p => p.EstudianteId)"
                                    Title="Id Estudiante"
                                    Sortable="true"
                                    Align="Align.Left" />

                    <PropertyColumn Property="@(p => p.estudiante.Nombres)"
                                    Title="Nombre"
                                    Sortable="true"
                                    Align="Align.Left" />

                    <PropertyColumn Property="@(p => p.LibrosId)"
                                    Title="Id Libro"
                                    Sortable="true"
                                    Align="Align.Left" />

                    <PropertyColumn Property="@(p => p.libros.Titulo)"
                                    Title="Título"
                                    Sortable="true"
                                    Align="Align.Left" />

                    <TemplateColumn Title="Opciones">
                        <a href="@($"/modificarPrestamo/{context.PrestamosId}")"
                           class="btn btn-outline-primary bi bi-pencil-square">
                        </a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>
                <strong>Cantidad: </strong>@itemsQueryable.Count()
            </label>
        </div>
    </div>
</div>

@code {
    private List<PrestamoLibros> ListaPrestamos { get; set; } = new();
    private IQueryable<PrestamoLibros> itemsQueryable =
        Enumerable.Empty<PrestamoLibros>().AsQueryable();

    private PrestamoLibros prestamo = new();

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await prestamoS.GetList(p => true);
        result.OnSuccess(p => ListaPrestamos = p);

        itemsQueryable = ListaPrestamos.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro == "")
        {
            var result = await prestamoS.GetList(p => true);
            result.OnSuccess(p => ListaPrestamos = p);
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Estudiante")
        {
            var result = await prestamoS.GetList(p =>
                p.estudiante.Nombres.ToLower()
                    .Contains(ValorFiltro.ToLower()));

            result.OnSuccess(p => ListaPrestamos = p);
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Titulo")
        {
            var result = await prestamoS.GetList(p =>
                p.libros.Titulo.ToLower()
                    .Contains(ValorFiltro.ToLower()));

            result.OnSuccess(p => ListaPrestamos = p);
        }

        itemsQueryable = ListaPrestamos.AsQueryable();
    }
}
