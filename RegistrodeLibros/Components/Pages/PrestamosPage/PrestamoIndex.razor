@page "/prestamoIndex"
@rendermode InteractiveServer

<PageTitle>Historial de Prestamos</PageTitle>


<div class="container">

    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h3 class="card-title"> Historial de Prestamos</h3>

            <a href="/crearPrestamo" class="btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span>Agregar Estudiante
            </a>

        </div>

        
        <div class="row align-items-end mb-4">

            @*labels*@
            <div class="col-md-3">

                @*Filtrar por*@
                <div>
                    <label class="form-label">
                        <strong>Filtrar por</strong>
                    </label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">

                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="ValorFiltro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Titulo">T&iacute;tulo</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="input-group">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi -search" @onclick="Buscar"> Buscar</button>
                    </div>
                </div>

            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@prestamos.AsQueryable()">
                    <PropertyColumn Property="@(p => p.PrestamosId)" title="Id Pr&eacute;stamo" Sortable="true" />
                    <PropertyColumn Property="@(p => p.EstudianteId)" title="Id Estudiante" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.estudiante.Nombres)" title="Nombre" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.LibrosId)" title="Id Libro" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.libros.Titulo)" title="T&iacute;tulo" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones">
                        <a href="/Prestamos/Modificar/@context.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>

                        <button class="btn btn-outline-danger bi bi-trash" @onclick="() => MostrarModal(context)"></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>

        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @prestamos.Count()</label>
        </div>

    </div>

</div>

@* Modal de confirmación *@
<Modal @ref="modal" Title="Confirmar Eliminación">

    <BodyTemplate>
        ¿Está seguro de que desea eliminar el préstamo "@prestamoSeleccionado.PrestamosId"?
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick"> No </Button>
        <Button Color="ButtonColor.Danger" @onclick="Eliminar"> Si </Button>
    </FooterTemplate>

</Modal>

@code {
    private List<PrestamoLibros> prestamos = new();
    private PrestamoLibros prestamoSeleccionado = new();
    private Modal modal;

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        prestamos = await prestamoS.GetList(p => true);
    }

    private async Task MostrarModal(PrestamoLibros prestamo)
    {
        prestamoSeleccionado = prestamo;
        await modal.ShowAsync();
    }


    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

    private async Task Eliminar()
    {
        bool eliminado = await prestamoS.Eliminar(prestamoSeleccionado.PrestamosId);

        if (eliminado)
        {
            prestamos = await prestamoS.GetList(p => true);
            toastServices.ShowSuccess("Préstamo eliminado correctamente.");
            await modal.HideAsync();
        }
        else
        {
            toastServices.ShowError("Error al eliminar el préstamo.");
        }
    }

    private async Task Buscar()
    {
        if (ValorFiltro == "")
        {
            prestamos = await prestamoS.GetList(p => true);
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Estudiante")
        {
            prestamos = await prestamoS.GetList(p =>
                p.estudiante.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Titulo")
        {
            prestamos = await prestamoS.GetList(p =>
                p.libros.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
        }

    }
}
