@page "/modificarPrestamo/{PrestamosId:int}"
@rendermode InteractiveServer

<PageTitle>Modificar Préstamo</PageTitle>

<EditForm Model="prestamo" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Modificar Préstamo</h5>
            </div>

            <div class="card-body">
                @* PrestamosId *@
                <div class="mb-3">
                    <label class="form-label"><strong>Id</strong></label>
                    <InputNumber class="form-control" @bind-Value="prestamo.PrestamosId" readonly />
                </div>

                @* EstudianteId *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="prestamo.EstudianteId">
                        <option value="0">Elija una opción</option>
                        @foreach (var estudiante in estudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                </div>

                @* LibrosId *@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="prestamo.LibrosId">
                        <option value="0">Elija una opción</option>
                        @foreach (var libro in libros)
                        {
                            <option value="@libro.LibroID">@libro.Titulo</option>
                        }
                    </InputSelect>
                </div>

                @* Footer *@
                <div class="card-footer text-center mt-2">
                    <a href="/Prestamos/Index" class="btn btn-secondary mt-2">
                        <span class="bi bi-arrow-left"></span> Volver
                    </a>

                    <button type="submit" class="btn btn-primary bi bi-floppy mt-2">
                        Guardar
                    </button>

                    <button type="button" class="btn btn-danger bi bi-trash mt-2"
                            data-bs-toggle="modal" data-bs-target="#modalEliminar">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                @if (prestamo != null)
                {
                    <p>¿Estás seguro de que deseas eliminar este préstamo?</p>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="Eliminar">
                    Confirmar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PrestamosId { get; set; }

    private PrestamoLibros prestamo { get; set; } = new PrestamoLibros();

    private List<Estudiantes> estudiantes { get; set; } = new List<Estudiantes>();
    private List<Libros> libros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        var resultPrestamo = await prestamoS.Buscar(PrestamosId);
        var resultEstudiantes = await estudianteS.GetList(e => true);
        var resultLibros = await libroService.GetList(l => true);

        resultPrestamo.OnSuccess(p => prestamo = p);
        resultEstudiantes.OnSuccess(e => estudiantes = e);
        resultLibros.OnSuccess(l => libros = l);
    }

    private async Task Modificar()
    {
        var resultModificado = await prestamoS.Guardar(prestamo);

        resultModificado.OnSuccess(() =>
        {
            toastServices.ShowSuccess("Préstamo modificado correctamente.");
            navigationManager.NavigateTo("/Prestamos/Index");
        });

        resultModificado.OnFailure(() =>
        {
            toastServices.ShowError("Error al modificar el préstamo.");
        });
    }

    private async Task Eliminar()
    {
        var resultEliminado = await prestamoS.Eliminar(PrestamosId);

        resultEliminado.OnSuccess(() =>
        {
            toastServices.ShowSuccess("Préstamo eliminado correctamente.");
            navigationManager.NavigateTo("/Prestamos/Index");
        });

        resultEliminado.OnFailure(() =>
        {
            toastServices.ShowError("Error al eliminar el préstamo.");
        });
    }
}