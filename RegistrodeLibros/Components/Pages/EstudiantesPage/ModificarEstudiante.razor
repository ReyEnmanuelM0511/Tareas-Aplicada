@page "/EstudiantesPage/modificarEstudiante/{EstudianteId:int}"
@rendermode InteractiveServer

<PageTitle>Modificar Estudiante</PageTitle>

<EditForm Model="estudiante" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Modificar Estudiante</h5>
            </div>

            <div class="card-body">
                @* EstudianteId *@
                <div class="mb-3">
                    <label class="form-label"><strong>EstudianteId</strong></label>
                    <InputNumber class="form-control" @bind-Value="estudiante.EstudianteId" readonly></InputNumber>
                </div>

                @* Nombres *@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Nombres"></InputText>
                </div>

                @* Direccion *@
                <div class="mb-3">
                    <label class="form-label"><strong>Dirección</strong></label>
                    <InputText class="form-control" @bind-Value="estudiante.Direccion"></InputText>
                </div>

                @* Email *@
                <div class="mb-3">
                    <label class="form-label"><strong>Email</strong></label>
                    <InputText class="form-control" typeof="email" @bind-Value="estudiante.Email"></InputText>
                </div>

                @* Fecha de Nacimiento *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate TValue="DateOnly" class="form-control" @bind-Value="estudiante.FechaNacimiento"></InputDate>
                </div>

                @* footer *@
                <div class="card-footer text-center mt-2">
                    <a href="/EstudianteIndex" class="btn btn-secondary mt-2">
                        <span class="bi bi-arrow-left"></span> Volver
                    </a>
                    <button type="submit" class="btn btn-primary bi bi-floppy mt-2"> Guardar</button>
                    <button type="button" class="btn btn-danger bi bi-trash mt-2"
                            data-bs-toggle="modal" data-bs-target="#modalEliminar">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@* Modal eliminacion *@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                @if (estudiante != null)
                {
                    <p>¿Estás seguro de que deseas eliminar al estudiante "@estudiante.Nombres"?</p>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="Eliminar">
                    Confirmar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int EstudianteId { get; set; }

    private Estudiantes estudiante { get; set; } = new Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        var result = await estudianteS.Buscar(EstudianteId);

        result.OnSuccess(e => estudiante = e);
    }

    private async Task Modificar()
    {
        var resultModificado = await estudianteS.Guardar(estudiante);

        resultModificado.OnSuccess(() =>
        {
            toastServices.ShowSuccess("Estudiante modificado correctamente.");
            navigationManager.NavigateTo("/EstudianteIndex");
        });

        resultModificado.OnFailure(() =>
        {
            toastServices.ShowError("Error al modificar al estudiante");
        });
    }

    private async Task Eliminar()
    {
        var resultEliminado = await estudianteS.Eliminar(estudiante.EstudianteId);

        resultEliminado.OnSuccess(() =>
        {
            toastServices.ShowSuccess("Estudiante eliminado correctamente.");
            navigationManager.NavigateTo("/EstudianteIndex");
        });

        resultEliminado.OnFailure(() =>
        {
            toastServices.ShowError("Error al eliminar el estudiante");
        });
    }
}


