@page "/modificarLibro/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Editar Libro</PageTitle>

<EditForm Model="libro" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h5 class="card-title mt-2">Editar Libro</h5>
            </div>

            <div class="card-body">
                @* LibroID *@
                <div class="mb-3">
                    <label class="form-label"><strong>LibroID</strong></label>
                    <InputNumber class="form-control" @bind-Value="libro.LibroID" readonly></InputNumber>
                </div>

                @* Titulo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Título</strong></label>
                    <InputText class="form-control" @bind-Value="libro.Titulo"></InputText>
                </div>

                @* Autor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Autor</strong></label>
                    <InputText class="form-control" @bind-Value="libro.Autor"></InputText>
                </div>

                @* Año de Publicacion *@
                <div class="mb-3">
                    <label class="form-label"><strong>Año de Publicación</strong></label>
                    <InputNumber class="form-control" @bind-Value="libro.AnoPublicacion"></InputNumber>
                </div>

                @*Disponibilidad*@
                @* Año de Publicacion *@
                <div class="mb-3">
                    <label class="form-label"><strong>Disponibilidad</strong></label>
                    <InputSelect class="form-control" @bind-Value="libro.Disponible"></InputSelect>
                </div>
            </div>

            @* footer *@
            <div class="card-footer text-center mt-2">
                <a href="/LibrosIndex"class="btn btn-secondary mt-2"><span class="bi bi-arrow-left"></span>Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy mt-2">Guardar</button>
                <button type="button" class="btn btn-danger bi bi-trash mt-2" data-bs-toggle="modal" data-bs-target="#modalEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal eliminacion *@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">               
                    <p>¿Está seguro que desea eliminar este libro?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="Eliminar">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Libros libro = new Libros();

    protected override async Task OnInitializedAsync()
    {
        var result = await libroService.Buscar(Id);
        result.OnSuccess(l => libro = l);
    }

    private async Task Modificar()
    {
        var resultModificado = await libroService.Guardar(libro);

        resultModificado.OnSuccess(() =>
        {
            toastServices.ShowSuccess(
                "Libro modificado correctamente.");

            navigationManager.NavigateTo("/LibrosIndex");
        });

        resultModificado.OnFailure(() =>
        {
            toastServices.ShowError(
                "Error al modificar el libro.");
        });
    }

    private async Task Eliminar()
    {
        var resultEliminado =
            await libroService.Eliminar(libro.LibroID);

        resultEliminado.OnSuccess(() =>
        {
            toastServices.ShowSuccess(
                "Libro eliminado correctamente.");

            navigationManager.NavigateTo("/LibrosIndex");
        });

        resultEliminado.OnFailure(() =>
        {
            toastServices.ShowError(
                "Error al eliminar el libro.");
        });
    }
}
