@page "/LibrosIndex"

@rendermode InteractiveServer

<PageTitle>Base de Datos Literaria</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h3 class="card-title">Listado de Libros</h3>
            <a href="/crearLibro" class="btn btn-primary"><span class="bi bi-plus-square mt-3"></span>Agregar Libro</a>
        </div>

        <div class="card-body">

            <div class="row align-items-end mb-4">

                <div class="col-md-3">
                    <label class="form-label"><strong>Filtrar por</strong></label>
                </div>

                <div class="col-md-4">
                    <label class="form-label"><strong>Búsqueda</strong></label>
                </div>

            </div>

            <div class="row align-items-center">
                <div class="col-md-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="">Elija una opción</option>
                        <option value="LibroID">LibroID</option>
                        <option value="Titulo">Título</option>
                        <option value="Autor">Autor</option>
                        <option value="AnioPublicacion">Año de publicación</option>
                    </InputSelect>
                </div>

                <div class="col-md-5">
                    <div class="input-group">
                        <input class="form-control"@bind="ValorFiltro"placeholder="Buscar libro..." />
                        <button type="button"class="btn btn-outline-primary"@onclick="Buscar"><span class="bi bi-search"></span>
                            Buscar
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property="@(l => l.LibroID)" Title="ID Libro"Sortable="true" />
                    <PropertyColumn Property="@(l => l.Titulo)" Title="Título"Sortable="true" />
                    <PropertyColumn Property="@(l => l.Autor)" Title="Autor"Sortable="true" />
                    <PropertyColumn Property="@(l => l.AnoPublicacion)" Title="Año de publicación"Sortable="true" />
                    <PropertyColumn Property="@(l => l.Disponible)" Title="Disponibilidad" Sortable="true" />
                    <TemplateColumn Title="Opciones">
                        <a href="@($"/modificarLibro/{context.LibroID}")" class="btn btn-outline-primary bi bi-pencil-square"></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        @*footer*@
        <div class="card-footer d-flex justify-content-between align-items-center mb-4">
            <label>Cantidad: @libros.Count</label>
        </div>

    </div>
</div>
```


@code {

    private ConfirmDialog dialog = default!;
    private List<Libros> libros = new();
    private IQueryable<Libros> itemsQueryable = Enumerable.Empty<Libros>().AsQueryable();

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await libroService.GetList(l => true);
        result.OnSuccess(l => libros = l);

        itemsQueryable = libros.AsQueryable();
    }

   

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(ValorFiltro))
        {
            var result = await libroService.GetList(l => true);
            result.OnSuccess(l => libros = l);
        }
        else if (Filtro.Trim() == "Autor")
        {
            var result = await libroService.GetList(l =>
                l.Autor.ToLower().Contains(ValorFiltro.ToLower()));

            result.OnSuccess(l => libros = l);
        }
        else if (Filtro.Trim() == "Titulo")
        {
            var result = await libroService.GetList(l =>
                l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));

            result.OnSuccess(l => libros = l);
        }
        else if (Filtro.Trim() == "LibroId")
        {
            if (int.TryParse(ValorFiltro, out int id))
            {
                var result = await libroService.GetList(l => l.LibroID == id);
                result.OnSuccess(l => libros = l);
            }
        }
        else if (Filtro.Trim() == "AnioPublicacion")
        {
            if (int.TryParse(ValorFiltro, out int anio))
            {
                var result = await libroService.GetList(l =>
                    l.AnoPublicacion == anio);

                result.OnSuccess(l => libros = l);
            }
        }

        itemsQueryable = libros.AsQueryable();
    }
}
