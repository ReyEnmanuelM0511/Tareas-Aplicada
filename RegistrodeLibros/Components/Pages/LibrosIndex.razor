@page "/LibrosIndex"

@using BlazorBootstrap
@using RegistrodeLibros.Extensors
@using RegistrodeLibros.Models
@using RegistrodeLibros.Services

@inject LibrosServices librosS
@inject ToastService toastServices
@rendermode InteractiveServer

<PageTitle>Base de Datos Literaria</PageTitle>
<ConfirmDialog @ref="dialog"/>


<div class="p-3 border rounded">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="mb-0">
            Listado de Libros
        </h3>

        <a href="/crearLibro" class="btn btn-primary">
            Agregar Libro
        </a>

    </div>

        
    <div class="row align-items-end mb-4">

        <div class="col-md-3">

            <label class="form-label">
                Filtrar por
            </label>

            <select class="form-select" @bind="filtroPor">

                <option value="">
                    Selecciona una opción
                </option>

                <option value="LibroID">
                    LibroID
                </option>

                <option value="Titulo">
                    Título
                </option>

                <option value="Autor">
                    Autor
                </option>

                <option value="AnioPublicacion">
                    Año Publicación
                </option>

            </select>

        </div>


        <div class="col-md-4">

            <label class="form-label">
                Buscar
            </label>

            <div class="input-group">

                <input class="form-control" @bind="filtro" placeholder="Buscar" />

                <button type="button"class="btn btn-outline-primary bi bi -search"@onclick="Buscar"> Buscar</button>

            </div>

        </div>

    </div>


    
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead>

                <tr>

                    <th>LibroID</th>

                    <th>Título</th>

                    <th>Autor</th>

                    <th>Año de Publicación</th>

                    <th>Acciones</th>

                </tr>

            </thead>


            <tbody>

                @foreach(var libro in libros){
                    <tr>
                        <td>@libro.LibroID</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.AnoPublicacion</td>
                        <td>
                            <a href="@($"/modificarLibro/{libro.LibroID}")" class="btn btn-primary bi bi-pencil-square" ></a>
                            <button class="btn btn-danger bi bi-trash" @onclick="() => Eliminar(libro)"></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p style="margin-top: 10px;">Cantidad: @libros.Count</p>

</div>


@code {

    private ConfirmDialog dialog = default!;
    private List<Libros> libros = new();

    private string filtro { get; set; } = string.Empty;
    private string filtroPor { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        libros = await librosS.GetList(l => true);
    }

    private async Task Eliminar(Libros libro)
    {

        var opciones = new ConfirmDialogOptions
        {
            YesButtonText = "Eliminar",
            YesButtonColor = ButtonColor.Danger,
            NoButtonText = "Cancelar",
            NoButtonColor = ButtonColor.Secondary,
            IsVerticallyCentered = true
        };

        bool confirmar = await dialog.ShowAsync(
            title: "Eliminar libro",
            message1: $"¿Está seguro de que desea eliminar \"{libro.Titulo}\"?",
            confirmDialogOptions: opciones);

        if (!confirmar)
            return;


        bool resultado = await librosS.Eliminar(libro.LibroID);

        if (resultado)
        {
            libros = await librosS.GetList(l => true);
            toastServices.ShowSuccess("Libro eliminado correctamente.");
        }
        else
        {
            toastServices.ShowError("Error al eliminar el libro.");
        }
    }

    private async Task Buscar()
    {
        if (filtro == "")
        {
            libros = await librosS.GetList(l => true);
        }
        else if (filtro.Trim() != "" && filtroPor == "Autor")
        {
            libros = await librosS.GetList(l =>
                l.Autor.ToLower().Contains(filtro.ToLower()));
        }
        else if (filtro.Trim() != "" && filtroPor == "Titulo")
        {
            libros = await librosS.GetList(l =>
                l.Titulo.ToLower().Contains(filtro.ToLower()));
        }
        else if (filtroPor == "LibroId")
        {
            if (int.TryParse(filtro, out int id))
            {
                libros = await librosS.GetList(l => l.LibroID == id);
            }
        }
        else if (filtroPor == "AnioPublicacion")
        {
            if (int.TryParse(filtro, out int anio))
            {
                libros = await librosS.GetList(l => l.AnoPublicacion == anio);
            }
        }

    }


}